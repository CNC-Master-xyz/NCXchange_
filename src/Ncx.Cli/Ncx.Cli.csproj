<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command line application ncx: convert, compile, format, check, analyze, trace, annotate, plugin. Depends on
    everything (architecture 3, 10; D74); tested from Ncx.Acceptance until it has a test project of its own
    (implementation 00-method 4).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ncx</ToolCommandName>
  </PropertyGroup>

  <!--
    The package of the .NET tool, versioned by the Version of Directory.Build.props: the id that P7-03 installs
    (dotnet tool install NCXchange.Cli), the MIT license of D75, the copyright holder of D165 and the
    repository (D347).
  -->
  <PropertyGroup>
    <PackageId>NCXchange.Cli</PackageId>
    <Authors>Peter Burgener</Authors>
    <Description>ncx, the command line of NCXchange: converts, checks, formats and compiles NCX programs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/NC-PB/NCXchange_</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ncx.Core/Ncx.Core.csproj" />
    <ProjectReference Include="../Ncx.Config/Ncx.Config.csproj" />
    <ProjectReference Include="../Ncx.Readers/Ncx.Readers.csproj" />
    <ProjectReference Include="../Ncx.Compilers/Ncx.Compilers.csproj" />
    <ProjectReference Include="../Ncx.Analytics/Ncx.Analytics.csproj" />
    <ProjectReference Include="../Ncx.Plugins/Ncx.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ncx.Acceptance" />
  </ItemGroup>

  <!--
    The shipped machine files and cycle catalogs next to the tool, in machines/ and cycles/ of its own folder, where
    ncx finds a machine by name and the catalog a machine names after the folders of the working directory
    (implementation 12, P2-04; machine-config 6, 10). The release keeps these loose copies; Ncx.Config builds the same
    files into the binary as the last place of the lookup (D371).
  -->
  <ItemGroup>
    <None Include="../../machines/*.toml" Link="machines/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../cycles/*.toml" Link="cycles/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The plugin template next to the tool, in templates/ncx-plugin/ of its own folder, which ncx plugin new copies
    (code-guidelines 11; implementation 17, P7-02); what a build of the template in its own folder leaves in bin/ and
    obj/ is no part of it.
  -->
  <ItemGroup>
    <None Include="../../templates/ncx-plugin/**"
          Exclude="../../templates/ncx-plugin/**/bin/**;../../templates/ncx-plugin/**/obj/**"
          Link="templates/ncx-plugin/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
