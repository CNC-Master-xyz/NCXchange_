<Project>

  <!--
    The settings of code-guidelines 9 for every project of the repository (implementation 00-method 3). CA1305 is
    an error through .editorconfig (D108). This file imports nothing from above the repository root: worktrees of this
    repository live under .worktrees/ and build with their own copy of it only.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Every executable (ncx, the test projects) runs culture-independent: the runtimeconfig.json carries
    System.Globalization.Invariant = true. It is set as this item and not as the InvariantGlobalization property,
    which the .NET analyzers read and then do not report CA1305 at all; so CA1305 checks every project (D108,
    code-guidelines 3.4 and 9).
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="true" />
  </ItemGroup>

</Project>
